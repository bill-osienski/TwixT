# Pytest cache
.pytest_cache/

# ONNX artifacts are ignored by default: exports land in scratch paths and must
# not be committed casually.
#
# Pinned, served models are the deliberate exception. They are committed under
# models/<content-address>/ together with their manifest, because a manifest
# whose hashes name an untracked file leaves no clone recoverable — which is
# the situation this exception exists to end. Roughly 7.2 MB per pinned model.
*.onnx
*.onnx.data
!models/*/*.onnx
!models/*/*.onnx.data
tests/probes/strong_advantage_probes.draft.json
tests/probes/strong_advantage_probes.draft.pre-thinning.json
tests/probes/candidates_strong_advantage.json
